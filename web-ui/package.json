{
  "name": "gvfi-desktop",
  "version": "1.0.0",
  "description": "GVFI AI 视频工作站桌面版",
  "author": "Mr. Gong",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Neo3328/GVFI.git"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/check-i18n-keys.js && node scripts/scan-acceptance.js",
    "test:ui": "node scripts/prod-acceptance.mjs",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron .",
    "prepare:standalone": "node scripts/prepare-standalone.js",
    "dist:win": "npm run build && npm run prepare:standalone && electron-builder --win --dir",
    "dist:win:installer": "npm run build && npm run prepare:standalone && electron-builder --win nsis",
    "dist:win:release": "npm run build && npm run prepare:standalone && electron-builder --win nsis portable",
    "dist": "npm run dist:win"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "ai.gvfi.desktop",
    "productName": "GVFI",
    "copyright": "Copyright © 2026 Mr. Gong. All Rights Reserved.",
    "directories": {
      "output": "dist-gvfi",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone",
        "filter": [
          "**/*",
          "!node_modules",
          "!node_modules/**/*",
          "!**/*.map",
          "!**/.env*"
        ]
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "public",
        "to": "standalone/public",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "GVFI-Portable-${version}-${arch}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "GVFI",
      "artifactName": "GVFI-Setup-${version}-${arch}.exe",
      "uninstallDisplayName": "GVFI ${version}"
    }
  }
}
